<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="132dp"
    android:orientation="horizontal"
    android:gravity="center">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp">
        <TextView
            android:id="@+id/notification_mcp"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/notification_mcp_light"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center"
            android:textSize="18sp" />
        <TextView
            android:id="@+id/notification_lock"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp">
        <TextView
            android:id="@+id/notification_proxy"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/notification_proxy_light"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center"
            android:textSize="18sp" />
        <TextView
            android:id="@+id/notification_kill"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp">
        <TextView
            android:id="@+id/notification_tunnel"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/notification_tunnel_light"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center"
            android:textSize="18sp" />
        <TextView
            android:id="@+id/notification_exit"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true" />
    </LinearLayout>
</LinearLayout>
