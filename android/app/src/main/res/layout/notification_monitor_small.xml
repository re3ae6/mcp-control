<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:orientation="vertical"
    android:padding="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/notification_mcp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="MCP"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"/>
            <TextView
                android:id="@+id/notification_mcp_light"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="●"
                android:textSize="15sp"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/notification_proxy"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Proxy"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"/>
            <TextView
                android:id="@+id/notification_proxy_light"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="●"
                android:textSize="15sp"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/notification_tunnel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Tunnel"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"/>
            <TextView
                android:id="@+id/notification_tunnel_light"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="●"
                android:textSize="15sp"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/notification_exit"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/notification_exit_bg"
        android:gravity="center"
        android:minHeight="46dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="EXIT"
        android:textAllCaps="true"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:clickable="true"
        android:contentDescription="Exit MCP Control"/>
</LinearLayout>
