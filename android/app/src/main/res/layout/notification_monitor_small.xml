<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/notification_mcp"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/notification_mcp_light"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/notification_proxy"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/notification_proxy_light"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/notification_tunnel"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/notification_tunnel_light"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
