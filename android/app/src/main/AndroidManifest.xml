<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <queries><package android:name="com.termux" /></queries>
    <application
        android:theme="@style/AppTheme"
        android:label="MCP Control"
        android:icon="@mipmap/mcp_control_launcher"
        android:roundIcon="@mipmap/mcp_control_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".PluginResultsService" android:exported="false" />
        <receiver android:name=".PluginResultsReceiver" android:exported="true" />
        <activity android:name=".PluginResultsActivity" android:exported="false" />
    </application>
</manifest>
